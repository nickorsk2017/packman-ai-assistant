{
  "version": "0.1.0",
  "configurations": [
    {
      "name": "Run Main App (Frontend)",
      "type": "node-terminal",
      "request": "launch",
      "command": "cd frontend/main-app && pnpm dev",
      "sourceMaps": true
    },
    {
      "name": "Run Device Microservice",
      "type": "node-terminal",
      "request": "launch",
      "command": "cd backend/device-service && pnpm start:dev",
      "sourceMaps": true
    },
    {
      "name": "Run AI Microservice",
      "type": "node-terminal",
      "request": "launch",
      "command": "cd backend/ai-service && uv run packman-ai-service",
      "sourceMaps": true
    }
  ]
}
