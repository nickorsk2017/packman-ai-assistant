{
  "name": "packman-product-service",
  "version": "1.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typeorm": "ts-node ./node_modules/typeorm/cli.js",
    "migration:generate": "pnpm typeorm migration:generate -d ormconfig.ts",
    "migration:run": "pnpm typeorm migration:run -d ormconfig.ts",
    "migration:revert": "pnpm typeorm migration:revert -d ormconfig.ts",
    "migration:show": "pnpm typeorm migration:show -d ormconfig.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.10",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.4.10",
    "@nestjs/platform-express": "^10.4.10",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.3.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
